# Public values must be prefixed with NEXT_PUBLIC_.
# Canonical site URL. Used as the base for OG / Twitter / canonical links
# so social previews (WhatsApp, Slack, Twitter, LinkedIn, etc.) resolve.
# Set this to your production domain. Defaults to the production domain.
NEXT_PUBLIC_SITE_URL=https://lanternliterarysociety.haybee.xyz

# Resend (transactional email -- contact form). Required once you wire Resend.
# RESEND_API_KEY=